<mxfile host="app.diagrams.net">
  <diagram name="Sayfa-1" id="gLGK9oG7kMag88L_44Ug">
    <mxGraphModel dx="2020" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\npackage models {\n    class Vluchteling {\n        - naam: String\n        - landVanHerkomst: Land\n        - huidigAZC: AZC\n        - dossier: Dossier\n        + Vluchteling(naam: String, landVanHerkomst: Land)\n        + plaatsInAZC(nieuwAZC: AZC): void\n        + getHuidigAZC(): AZC\n        + getDossier(): Dossier\n        + getNaam(): String\n        + getLandVanHerkomst(): Land\n    }\n\n    class AZC {\n        - naam: String\n        - straat: String\n        - huisnummer: String\n        - postcode: String\n        - gemeente: Gemeente\n        - gehuisvesteVluchtelingen: List&lt;Vluchteling&gt;\n        + AZC(naam: String, straat: String, huisnummer: String, postcode: String, gemeente: Gemeente)\n        + voegVluchtelingToe(v: Vluchteling): void\n        + verwijderVluchteling(v: Vluchteling): void\n        + getGemeente(): Gemeente\n        + getNaam(): String\n        + getStraat(): String\n        + getHuisnummer(): String\n        + getPostcode(): String\n        + getGehuisvesteVluchtelingen(): List&lt;Vluchteling&gt;\n    }\n\n    class Gemeente {\n        - naam: String\n        - aantalInwoners: int\n        - aangebodenPlaatsen: int\n        - aantalGeplaatsteVluchtelingen: int\n        - azcs: List&lt;AZC&gt;\n        + Gemeente(naam: String, aantalInwoners: int, aangebodenPlaatsen: int)\n        + voegAZCToe(azc: AZC): void\n        + getAzcs(): List&lt;AZC&gt;\n        + getVrijePlaatsen(): int\n        + getAantalGeplaatsteVluchtelingen(): int\n        + getRelatieveBelasting(): double\n        + voegVluchtelingToe(): void\n        + getNaam(): String\n        + getAantalInwoners(): int\n        + getAangebodenPlaatsen(): int\n    }\n\n    class Land {\n        - naam: String\n        - isVeilig: boolean\n        + Land(naam: String, isVeilig: boolean)\n        + getNaam(): String\n        + isVeilig(): boolean\n    }\n\n    class Beheerder {\n        - naam: String\n        - rapportageService: RapportageService\n        + Beheerder(naam: String)\n        + vraagRapportageOp(gemeentes: List&lt;Gemeente&gt;): void\n    }\n\n    class COAMedewerker {\n        - naam: String\n        - context: PlaatsingsContext\n        + COAMedewerker(naam: String)\n        + voerAutomatischePlaatsing(gemeentes: List&lt;Gemeente&gt;, strategie: PlaatsingsStrategie): Gemeente\n    }\n\n    class AZCMedewerker {\n        - naam: String\n        + AZCMedewerker(naam: String)\n        + verwerkBericht(bericht: Bericht, kamerNummer: String): void\n    }\n}\n\npackage observer {\n    interface DossierSubject {\n        + voegObserverToe(observer: DossierObserver): void\n        + verwijderObserver(observer: DossierObserver): void\n        + stuurNotificatie(bericht: Bericht): void\n    }\n\n    interface DossierObserver {\n        + update(bericht: Bericht): void\n    }\n\n    class Dossier {\n        - uitspraak: String\n        - observers: List&lt;DossierObserver&gt;\n        - eigenaar: Vluchteling\n        + Dossier(eigenaar: Vluchteling)\n        + setUitspraak(uitspraak: String): void\n        + getUitspraak(): String\n    }\n\n    class Berichtenbox {\n        - ongelezenBerichten: List&lt;Bericht&gt;\n        + getOngelezenBerichten(): List&lt;Bericht&gt;\n    }\n\n    class Bericht {\n        - vluchteling: Vluchteling\n        - typeBericht: String\n        - inhoud: String\n        - isVerwerkt: boolean\n        - kamer: String\n        + Bericht(vluchteling: Vluchteling, typeBericht: String, inhoud: String)\n        + getInhoud(): String\n        + getVluchteling(): Vluchteling\n        + getTypeBericht(): String\n        + isVerwerkt(): boolean\n        + getKamer(): String\n        + markeerAlsVerwerkt(kamer: String): void\n    }\n}\n\npackage strategy {\n    interface PlaatsingsStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class HoogsteVrijePlaatsenStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class LaagsteRelatieveBelastingStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class PlaatsingsContext {\n        - actieveStrategie: PlaatsingsStrategie\n        + setStrategie(strategie: PlaatsingsStrategie): void\n        + voerPlaatsingUit(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n}\n\npackage template {\n    abstract class ActieVerwerker {\n        + verwerkActie(): void\n        # {abstract} controleerVoorwaarden(): boolean\n        # {abstract} voerHoofdActieUit(): void\n        # {abstract} werkAdministratieBij(): void\n        # {abstract} geefTerugkoppeling(): void\n    }\n\n    class VluchtelingPlaatsingActie {\n        - vluchteling: Vluchteling\n        - nieuwAZC: AZC\n        + VluchtelingPlaatsingActie(vluchteling: Vluchteling, nieuwAZC: AZC)\n    }\n\n    class VluchtelingRegistratieActie {\n        - vluchteling: Vluchteling\n        + VluchtelingRegistratieActie(vluchteling: Vluchteling)\n    }\n}\n\npackage service {\n    class RapportageService {\n        + genereerManagementRapport(gemeentes: List&lt;Gemeente&gt;): void\n    }\n}\n\n&#39; Relations\nVluchteling \&quot;1\&quot; --&gt; \&quot;1\&quot; Land : landVanHerkomst\nVluchteling \&quot;0..1\&quot; --&gt; \&quot;1\&quot; AZC : huidigAZC\nVluchteling \&quot;1\&quot; *-- \&quot;1\&quot; Dossier : dossier\n\nAZC \&quot;1\&quot; --&gt; \&quot;1\&quot; Gemeente : gemeente\nAZC \&quot;1\&quot; o-- \&quot;*\&quot; Vluchteling : gehuisvesteVluchtelingen\nGemeente \&quot;1\&quot; o-- \&quot;*\&quot; AZC : azcs\n\nDossier ..|&gt; DossierSubject\nBerichtenbox ..|&gt; DossierObserver\nDossier \&quot;1\&quot; o-- \&quot;*\&quot; DossierObserver : observers\nDossier \&quot;1\&quot; --&gt; \&quot;1\&quot; Vluchteling : eigenaar\nBerichtenbox \&quot;1\&quot; o-- \&quot;*\&quot; Bericht : ongelezenBerichten\nBericht \&quot;1\&quot; --&gt; \&quot;1\&quot; Vluchteling : vluchteling\n\nPlaatsingsContext \&quot;1\&quot; o-- \&quot;1\&quot; PlaatsingsStrategie : actieveStrategie\nHoogsteVrijePlaatsenStrategie ..|&gt; PlaatsingsStrategie\nLaagsteRelatieveBelastingStrategie ..|&gt; PlaatsingsStrategie\n\nVluchtelingPlaatsingActie --|&gt; ActieVerwerker\nVluchtelingRegistratieActie --|&gt; ActieVerwerker\nVluchtelingPlaatsingActie --&gt; Vluchteling\nVluchtelingPlaatsingActie --&gt; AZC\nVluchtelingRegistratieActie --&gt; Vluchteling\n\nBeheerder \&quot;1\&quot; --&gt; \&quot;1\&quot; RapportageService : uses\nCOAMedewerker \&quot;1\&quot; --&gt; \&quot;1\&quot; PlaatsingsContext : uses\nAZCMedewerker ..&gt; Bericht : processes\n\n@endum&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="-7jWQsT2L7dmD6th-n33-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
