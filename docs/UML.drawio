<mxfile host="app.diagrams.net" modified="2026-07-03T00:00:00.000Z" agent="OpenAI" version="24.7.17">
  <diagram name="UML - gecorrigeerd" id="opt3-corrected-uml">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1574" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nleft to right direction\n\n\npackage util {\n    class Validatie &lt;&lt;utility&gt;&gt; {\n        + {static} vereisTekst(waarde: String, veldnaam: String): String\n    }\n}\n\npackage app {\n    class Main {\n        - Main()\n        + {static} main(args: String[]): void\n    }\n}\n\npackage models {\n    class Land {\n        - naam: String\n        - veilig: boolean\n        + Land(naam: String, veilig: boolean)\n        + getNaam(): String\n        + isVeilig(): boolean\n    }\n\n    class Vluchteling {\n        - naam: String\n        - landVanHerkomst: Land\n        - dossier: Dossier\n        - huidigAZC: AZC\n        + Vluchteling(naam: String, landVanHerkomst: Land)\n        + plaatsInAZC(nieuwAZC: AZC): void\n        + getHuidigAZC(): AZC\n        + getDossier(): Dossier\n        + getNaam(): String\n        + getLandVanHerkomst(): Land\n    }\n\n    class Dossier {\n        - uitspraak: String\n        - observers: List&lt;DossierObserver&gt;\n        - eigenaar: Vluchteling\n        + Dossier(eigenaar: Vluchteling)\n        + setUitspraak(uitspraak: String): void\n        + getUitspraak(): String\n        + voegObserverToe(observer: DossierObserver): void\n        + verwijderObserver(observer: DossierObserver): void\n        + stuurNotificatie(bericht: Bericht): void\n    }\n\n    class Gemeente {\n        - naam: String\n        - aantalInwoners: int\n        - aangebodenPlaatsen: int\n        - aantalGeplaatsteVluchtelingen: int\n        - azcs: List&lt;AZC&gt;\n        + Gemeente(naam: String, aantalInwoners: int, aangebodenPlaatsen: int)\n        + voegAZCToe(azc: AZC): void\n        + getAzcs(): List&lt;AZC&gt;\n        + getVrijePlaatsen(): int\n        + getAantalGeplaatsteVluchtelingen(): int\n        + getRelatieveBelasting(): double\n        + voegVluchtelingToe(): void\n        + verwijderVluchteling(): void\n        + getNaam(): String\n        + getAantalInwoners(): int\n        + getAangebodenPlaatsen(): int\n    }\n\n    class AZC {\n        - naam: String\n        - straat: String\n        - huisnummer: String\n        - postcode: String\n        - gemeente: Gemeente\n        - gehuisvesteVluchtelingen: List&lt;Vluchteling&gt;\n        + AZC(naam: String, straat: String, huisnummer: String, postcode: String, gemeente: Gemeente)\n        + voegVluchtelingToe(vluchteling: Vluchteling): void\n        + verwijderVluchteling(vluchteling: Vluchteling): void\n        + getGemeente(): Gemeente\n        + getNaam(): String\n        + getStraat(): String\n        + getHuisnummer(): String\n        + getPostcode(): String\n        + getGehuisvesteVluchtelingen(): List&lt;Vluchteling&gt;\n    }\n\n    class COAMedewerker {\n        - naam: String\n        - context: PlaatsingsContext\n        + COAMedewerker(naam: String)\n        + voerAutomatischePlaatsing(gemeentes: List&lt;Gemeente&gt;, strategie: PlaatsingsStrategie): Gemeente\n    }\n\n    class AZCMedewerker {\n        - naam: String\n        + AZCMedewerker(naam: String)\n        + verwerkBericht(bericht: Bericht, kamerNummer: String): void\n    }\n\n    class Beheerder {\n        - naam: String\n        - rapportageService: RapportageService\n        + Beheerder(naam: String)\n        + Beheerder(naam: String, rapportageService: RapportageService)\n        + vraagRapportageOp(gemeentes: List&lt;Gemeente&gt;): void\n    }\n}\n\npackage observer {\n    interface DossierSubject {\n        + voegObserverToe(observer: DossierObserver): void\n        + verwijderObserver(observer: DossierObserver): void\n        + stuurNotificatie(bericht: Bericht): void\n    }\n\n    interface DossierObserver {\n        + update(bericht: Bericht): void\n    }\n\n    class Bericht {\n        - vluchteling: Vluchteling\n        - typeBericht: String\n        - inhoud: String\n        - verwerkt: boolean\n        - kamer: String\n        + Bericht(vluchteling: Vluchteling, typeBericht: String, inhoud: String)\n        + getInhoud(): String\n        + getVluchteling(): Vluchteling\n        + getTypeBericht(): String\n        + isVerwerkt(): boolean\n        + getKamer(): String\n        + markeerAlsVerwerkt(kamer: String): void\n    }\n\n    class Berichtenbox {\n        - berichten: List&lt;Bericht&gt;\n        + update(bericht: Bericht): void\n        + getOngelezenBerichten(): List&lt;Bericht&gt;\n        + getAlleBerichten(): List&lt;Bericht&gt;\n    }\n}\n\npackage strategy {\n    interface PlaatsingsStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class PlaatsingsContext {\n        - actieveStrategie: PlaatsingsStrategie\n        + setStrategie(strategie: PlaatsingsStrategie): void\n        + voerPlaatsingUit(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class HoogsteVrijePlaatsenStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n\n    class LaagsteRelatieveBelastingStrategie {\n        + kiesGemeente(gemeentes: List&lt;Gemeente&gt;): Gemeente\n    }\n}\n\npackage template {\n    abstract class ActieVerwerker {\n        + verwerkActie(): void\n        # {abstract} controleerVoorwaarden(): boolean\n        # {abstract} voerHoofdActieUit(): void\n        # {abstract} werkAdministratieBij(): void\n        # {abstract} geefTerugkoppeling(): void\n    }\n\n    class VluchtelingRegistratieActie {\n        - vluchteling: Vluchteling\n        + VluchtelingRegistratieActie(vluchteling: Vluchteling)\n    }\n\n    class VluchtelingPlaatsingActie {\n        - vluchteling: Vluchteling\n        - nieuwAZC: AZC\n        + VluchtelingPlaatsingActie(vluchteling: Vluchteling, nieuwAZC: AZC)\n    }\n}\n\npackage service {\n    class RapportageService {\n        + genereerManagementRapport(gemeentes: List&lt;Gemeente&gt;): void\n    }\n}\n\nVluchteling \&quot;1\&quot; --&gt; \&quot;1\&quot; Land : landVanHerkomst\nVluchteling \&quot;1\&quot; *-- \&quot;1\&quot; Dossier : dossier\nVluchteling \&quot;0..1\&quot; --&gt; \&quot;1\&quot; AZC : huidigAZC\nDossier ..|&gt; DossierSubject\nDossier \&quot;1\&quot; o-- \&quot;*\&quot; DossierObserver : observers\nDossier --&gt; Bericht : maakt\nGemeente \&quot;1\&quot; o-- \&quot;*\&quot; AZC : azcs\nAZC \&quot;1\&quot; --&gt; \&quot;1\&quot; Gemeente : gemeente\nAZC \&quot;1\&quot; o-- \&quot;*\&quot; Vluchteling : bewoners\nBerichtenbox ..|&gt; DossierObserver\nBerichtenbox \&quot;1\&quot; o-- \&quot;*\&quot; Bericht : berichten\nBericht --&gt; Vluchteling\nPlaatsingsContext --&gt; PlaatsingsStrategie\nHoogsteVrijePlaatsenStrategie ..|&gt; PlaatsingsStrategie\nLaagsteRelatieveBelastingStrategie ..|&gt; PlaatsingsStrategie\nVluchtelingRegistratieActie --|&gt; ActieVerwerker\nVluchtelingPlaatsingActie --|&gt; ActieVerwerker\nVluchtelingRegistratieActie --&gt; Vluchteling\nVluchtelingPlaatsingActie --&gt; Vluchteling\nVluchtelingPlaatsingActie --&gt; AZC\nCOAMedewerker --&gt; PlaatsingsContext\nAZCMedewerker ..&gt; Bericht\nBeheerder --&gt; RapportageService\nMain ..&gt; COAMedewerker\nMain ..&gt; ActieVerwerker\nMain ..&gt; Berichtenbox\nMain ..&gt; Beheerder\nVluchteling ..&gt; Validatie : valideert\nGemeente ..&gt; Validatie : valideert\nBericht ..&gt; Validatie : valideert\n@enduml\n&quot;,&#10;  &quot;format&quot;: &quot;svg&quot;&#10;}" id="uml-image">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
